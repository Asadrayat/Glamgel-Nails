{% liquid
  assign id = section.id
%}

<style>
  .sec-{{ id }} {
    box-sizing: border-box;
    margin-top: {{section.settings.margin_top | append: 'px'}};
    margin-bottom: {{section.settings.margin_bottom | append: 'px'}};
    padding-top: {{section.settings.padding_top | append: 'px'}};
    padding-bottom: {{section.settings.padding_bottom | append: 'px'}};
    background: {{ section.settings.background_color }};
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;    
    .wrapper-{{ id }} {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--Spacing-Container-xl, 60px);
      align-items: center;
      
      @media(max-width: 768px) {
        grid-template-columns: 1fr;
        gap: var(--Spacing-Container-lg, 40px);
      }
    }
    
    .image-wrapper__ {
      order: {{ section.settings.image_position | default: 'left' | replace: 'left', '0' | replace: 'right', '1' }};
      
      @media(max-width: 768px) {
        order: 0;
      }
    }
    
    .content-wrapper__ {
      order: {{ section.settings.image_position | default: 'left' | replace: 'left', '1' | replace: 'right', '0' }};
      
      @media(max-width: 768px) {
        order: 1;
      }
    }
    
    .image__ {
      width: 100%;
      height: auto;
      border-radius: 16px;
      object-fit: cover;
      
      img {
        width: 100%;
        height: auto;
        border-radius: 16px;
        display: block;
      }
    }
    
    .heading__ {
        color: #000;
        text-align: center;

        /* Headings/H2 */
        font-family: var(--font-family-Heading, Minakoe);
        font-size: var(--Font-Size-Heading-H2, 32px);
        font-style: normal;
        font-weight: 400;
        line-height: var(--Line-Height-Heading-H2, 36px); /* 112.5% */
        margin: 0 0 48px;
      @media(max-width: 768px) {
        font-size: 28px;
        line-height: 36px;
        margin: 0 0 32px;
      }
    }
    
    .heading__ span {
      display: block;
        font-family: var(--font-family-Heading, Minakoe);
        font-size: var(--Font-Size-Heading-H2, 32px);
        font-style: normal;
        font-weight: 400;
        line-height: var(--Line-Height-Heading-H2, 36px); /* 112.5% */      
      color: #7F2748;
    }
    
    .features__ {
      display: flex;
      flex-direction: column;
      gap: 80px;
      @media(max-width: 768px) {
        gap: 24px;
      }
    }
    
    .feature__ {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    
    .feature__title {
        color: #000;
        font-family: var(--font-family-Heading, Minakoe);
        font-size: var(--Font-Size-Heading-H3, 20px);
        font-style: normal;
        font-weight: 400;
        line-height: var(--Line-Height-Heading-H3, 24px);
        margin: 0 0 12px;
    }
    
    .feature__description {
        font-family: var(--font-body-family);
        color: #000;
        font-size: var(--Font-Size-Paragraph-Medium, 14px);
        font-style: normal;
        font-weight: 700;
        line-height: var(--Line-Height-Paragraph-Medium, 20px);
        margin: 0;
        text-shadow: 0 0 BLACK;
    }
  }

  @media(max-width: 600px) {
    .sec-{{ id }} {
      margin-top: {{section.settings.margin_top_m | append: 'px'}};
      margin-bottom: {{section.settings.margin_bottom_m | append: 'px'}};
      padding-top: {{section.settings.padding_top_m | append: 'px'}};
      padding-bottom: {{section.settings.padding_bottom_m | append: 'px'}};
    }
  }
</style>

<div class="sec-{{ id }}" id="{{ section.settings.sec_id }}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    {% unless section.settings.heading == blank %}
      <h2 class="heading__">
        {{ section.settings.heading }}
        {% unless section.settings.heading_accent == blank %}
          <span>{{ section.settings.heading_accent }}</span>
        {% endunless %}
      </h2>
    {% endunless %}
    
    <div class="wrapper-{{ id }}">
      <div class="image-wrapper__">
        {% unless section.settings.image == blank %}
          <div class="image__">
            {{ section.settings.image | image_url: width: 600 | image_tag }}
          </div>
        {% else %}
          <div class="image__" style="background: #E8E8E8; aspect-ratio: 1/1; border-radius: 16px;"></div>
        {% endunless %}
      </div>
      
      <div class="content-wrapper__">
        <div class="features__">
          {% for block in section.blocks %}
            <div class="feature__" {{ block.shopify_attributes }}>
              {% unless block.settings.title == blank %}
                <h3 class="feature__title">{{ block.settings.title }}</h3>
              {% endunless %}
              
              {% unless block.settings.description == blank %}
                <p class="feature__description">{{ block.settings.description }}</p>
              {% endunless %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "New Image Text",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Section",
      "default": false
    },
    {
      "type": "text",
      "id": "sec_id",
      "label": "Section Id"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F5E6ED"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Glam Gel Nails are"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent Line",
      "default": "Perfect for You"
    },
    {
      "type": "header",
      "content": "Section Spacing Desktop"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Section Spacing Mobile"
    },
    {
      "type": "range",
      "id": "margin_top_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Feature description goes here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Image Text",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Salon-Perfect, Wallet-Friendly",
            "description": "Get the gorgeous nails you love without the $50+ price tag."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Skip the Extra Spend",
            "description": "No tips, no gas, no sitter. Just beautiful nails anytime, anywhere."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Stretch Your Beauty Budget",
            "description": "Get multiple months for what you'd spend on just one at the salon"
          }
        }
      ]
    }
  ]
}
{% endschema %}
{% liquid
  assign id = section.id
%}

<style>
  .sec-{{ id }} {
    box-sizing: border-box;
    margin-top: {{section.settings.margin_top | append: 'px'}};
    margin-bottom: {{section.settings.margin_bottom | append: 'px'}};
    padding-top: {{section.settings.padding_top | append: 'px'}};
    padding-bottom: {{section.settings.padding_bottom | append: 'px'}};
    background: {{ section.settings.background_color }};
    max-width: 100%;
    overflow: hidden;
    
    .wrapper-{{ id }} {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--Spacing-Container-xl, 60px);
      align-items: center;
      
      @media(max-width: 768px) {
        grid-template-columns: 1fr;
        gap: var(--Spacing-Container-lg, 40px);
      }
    }
    
    .image-wrapper__ {
      order: {{ section.settings.image_position | default: 'left' | replace: 'left', '0' | replace: 'right', '1' }};
      
      @media(max-width: 768px) {
        order: 0;
      }
    }
    
    .content-wrapper__ {
      order: {{ section.settings.image_position | default: 'left' | replace: 'left', '1' | replace: 'right', '0' }};
      
      @media(max-width: 768px) {
        order: 1;
      }
    }
    
    .image__ {
      width: 100%;
      height: auto;
      border-radius: 16px;
      object-fit: cover;
      
      img {
        width: 100%;
        height: auto;
        border-radius: 16px;
        display: block;
      }
    }
    
    .heading__ {
    color: #000;

    /* Headings/H2 */
    font-family: var(--font-family-Heading, Minakoe);
    font-size: var(--Font-Size-Heading-H2, 32px);
    font-style: normal;
    font-weight: 400;
    line-height: var(--Line-Height-Heading-H2, 36px); /* 112.5% */
      margin: 0 0 24px;
      @media(max-width: 768px) {
        line-height: 112%;
        margin: 0 0 16px;
      }
      
      @media(max-width: 600px) {
        font-size: 28px;
        line-height: 112%;
        line-height: 40px;
      }
    }
    
    .heading__ span {
        font-family: var(--font-family-Heading, Minakoe);
        font-size: var(--Font-Size-Heading-H2, 32px);
        font-style: normal;
        font-weight: 400;
        line-height: var(--Line-Height-Heading-H2, 36px); /* 112.5% */
        color: #7F2748;
        display: block;
      
      @media(max-width: 768px) {
        font-size: 28px;
        line-height: 112%;
      }
      
      @media(max-width: 600px) {
        font-size: 32px;
        line-height: 40px;
      }
    }
    
    .content__ {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    
    .paragraph__ {
      font-family: var(--font-body-family, "Cabinet Grotesk");
      color: #000;
      font-size: var(--Font-Size-Paragraph-Medium, 15px);
      font-style: normal;
      font-weight: 700;
      line-height: var(--Line-Height-Paragraph-Medium, 24px);
      margin: 0;
      text-shadow: 0 0 Black;
      @media(max-width: 600px) {
        font-size: 14px;
        line-height: 22px;
      }
    }
    
    .author__ {
      font-family: var(--font-body-family, "Cabinet Grotesk");
      color: #000;
      font-size: 14px;
      font-style: normal;
      font-weight: 500;
      line-height: 20px;
      margin: 8px 0 32px;
      
      @media(max-width: 600px) {
        margin: 8px 0 24px;
      }
    }
    
    .cta_button {
      width: max-content;
    }
  }

  @media(max-width: 600px) {
    .sec-{{ id }} {
      margin-top: {{section.settings.margin_top_m | append: 'px'}};
      margin-bottom: {{section.settings.margin_bottom_m | append: 'px'}};
      padding-top: {{section.settings.padding_top_m | append: 'px'}};
      padding-bottom: {{section.settings.padding_bottom_m | append: 'px'}};
    }
  }
</style>

<div class="sec-{{ id }}" id="{{ section.settings.sec_id }}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="wrapper-{{ id }}">
      <div class="content-wrapper__">
        {% unless section.settings.heading == blank %}
          <h2 class="heading__">
            {{ section.settings.heading }}
            {% unless section.settings.heading_accent == blank %}
              <span>{{ section.settings.heading_accent }}</span>
            {% endunless %}
          </h2>
        {% endunless %}
        
        <div class="content__">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'paragraph' %}
                <p class="paragraph__" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </p>
              {% when 'author' %}
                <p class="author__" {{ block.shopify_attributes }}>
                  {{ block.settings.author_text }}
                </p>
            {% endcase %}
          {% endfor %}
          
          {% unless section.settings.button_text == blank %}
            <div>
              <a href="{{ section.settings.button_url }}" class="cta_button">
                {{ section.settings.button_text }}
              </a>
            </div>
          {% endunless %}
        </div>
      </div>
      
      <div class="image-wrapper__">
        {% unless section.settings.image == blank %}
          <div class="image__">
            {{ section.settings.image | image_url: width: 800 | image_tag }}
          </div>
        {% else %}
          <div class="image__" style="background: #E8E8E8; aspect-ratio: 4/5; border-radius: 16px;"></div>
        {% endunless %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Founder Story",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Section",
      "default": false
    },
    {
      "type": "text",
      "id": "sec_id",
      "label": "Section Id"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFF5FF"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Frustrated Mom to"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent Line",
      "default": "Beauty Innovator"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Gel Nail Strips"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Section Spacing Desktop"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Section Spacing Mobile"
    },
    {
      "type": "range",
      "id": "margin_top_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Like millions of women, I was spending $200+ monthly on salon visits while juggling kids, work, and life. The breaking point came when I realized my nail budget was bigger than my grocery budget."
        }
      ]
    },
    {
      "type": "author",
      "name": "Author",
      "settings": [
        {
          "type": "text",
          "id": "author_text",
          "label": "Author Text",
          "default": "- Rachel, Founder of GGN"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Founder Story",
      "blocks": [
        {
          "type": "paragraph",
          "settings": {
            "text": "Like millions of women, I was spending $200+ monthly on salon visits while juggling kids, work, and life. The breaking point came when I realized my nail budget was bigger than my grocery budget."
          }
        },
        {
          "type": "paragraph",
          "settings": {
            "text": "That's when I discovered the secret: professional-grade gel strips that deliver salon results at home. No more paying top dollar for rushed appointments, inconvenient scheduling, or chipped polish days later."
          }
        },
        {
          "type": "paragraph",
          "settings": {
            "text": "Today, over 100,000 women have joined the GGN revolution, saving thousands while looking fabulous."
          }
        },
        {
          "type": "author",
          "settings": {
            "author_text": "- Rachel, Founder of GGN"
          }
        }
      ]
    }
  ]
}
{% endschema %}
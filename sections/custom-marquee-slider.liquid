{% liquid
  assign id = section.id
%}

<style>
  #shopify-section-{{id}} {
    box-sizing: border-box;
    margin-top: {{section.settings.margin_top | append: 'px'}};
    margin-bottom: {{section.settings.margin_bottom | append: 'px'}};
    padding-top: {{section.settings.padding_top | append: 'px'}};
    padding-bottom: {{section.settings.padding_bottom | append: 'px'}};
    background: #f1c0d6;
    overflow: hidden;
  }

  @media(max-width: 768px) {
    #shopify-section-{{id}} {
      margin-top: {{section.settings.margin_top_m | append: 'px'}};
      margin-bottom: {{section.settings.margin_bottom_m | append: 'px'}};
      padding-top: {{section.settings.padding_top_m | append: 'px'}};
      padding-bottom: {{section.settings.padding_bottom_m | append: 'px'}};
    }
  }
  .wrapper-{{ id }} {
    padding: 32px 0 32px 0;
    display: flex;
    gap: 24px;
    align-items: center;
     animation: marquee-{{ id }} 20s linear infinite;
    @media(max-width: 768px){
      padding: 16px 0 16px 0;
      animation: marquee-{{ id }} 12s linear infinite;
    }
  }
  .wrapper-{{ id }} .swiper{
    overflow: visible;
  }
  .wrapper-{{ id }} .swiper-wrapper {
    transition-timing-function: linear !important;
  }
  .wrapper-{{ id }} .swiper-slide{
    width: max-content;
  }
  .marquee__item{
    display: flex;
    align-items: center;
    gap: 32px;
    flex-shrink: 0;
  }
  .marquee__item img{
    max-width: 75px;
    height: auto;
    object-fit: cover;
  }
  .marquee__item p{
    color: #000;
    /* font-family: Satoshi; */
    font-size: 20px;
    font-style: normal;
    font-weight: 500;
    line-height: 24px; /* 120% */
    text-transform: uppercase;
    margin: 0;
  }
  .marquee__item svg{
    width: 37.84px;
    height: 40px;
    flex-shrink: 0;
    @media(max-width: 768px){
      width: 20px;
      height: 24px;
      flex-shrink: 0;
    }
  }
  @keyframes marquee-{{ id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } /* shift left by half (since duplicated) */
  }
  @media screen and (max-width: 768px){
    .marquee__item{
      gap: 12px;
    }
    .marquee__item img{
      max-width: 45px;
    }
    .marquee__item p{
      color: #000;
      font-family: Satoshi;
      font-size: 16px;
      font-style: normal;
      font-weight: 500;
      line-height: 20px; /* 125% */
      text-transform: uppercase;
    }
  }
</style>

{% comment %}
  <div class="sec-{{ id }}">
    <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
      <div class="wrapper-{{ id }}">
        <div class="swiper">
          <div class="swiper-wrapper">
            {% for i in (1..20) %}
              {% for block in section.blocks %}
                <div class="swiper-slide">
                  <div class="marquee__item">
                    {% render 'star' %}
                    {% if block.settings.title != blank %}
                      <p>{{ block.settings.title }}</p>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endcomment %}
<div class="sec-{{ id }}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    <div class="wrapper-{{ id }}">
      {% for i in (1..20) %}

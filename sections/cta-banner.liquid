{% liquid
  assign id = section.id
%}

<style>
  #shopify-section-{{id}}  {
    box-sizing: border-box;
    margin-top: {{section.settings.margin_top | append: 'px'}};
    margin-bottom: {{section.settings.margin_bottom | append: 'px'}};
    padding-top: {{section.settings.padding_top | append: 'px'}};
    padding-bottom: {{section.settings.padding_bottom | append: 'px'}};
    background: {{ section.settings.background_color }};

    .cta-container__ {
      border-radius: 24px;
      padding-block: 80px;
      text-align: center;
      margin: 0 auto;
      position: relative;
      overflow: hidden;
      {% if section.settings.background_image != blank %}
        background-image: url('{{ section.settings.background_image | image_url: width: 1400 }}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      {% else %}
        background: {{ section.settings.card_background }};
      {% endif %}

      @media(max-width: 768px) {
        padding-block: 60px;
        border-radius: 16px;
      }

      @media(max-width: 600px) {
        padding: 48px 24px;
      }
    }
    .content__wrapper__ {
        max-width: 800px;
        margin: auto;
    }
    .heading__ {
      font-family: var(--font-heading-family, Minakoe);
      font-size: var(--Font-Size-Heading-H2, 40px);
      font-style: normal;
      font-weight: 400;
      line-height: var(--Line-Height-Heading-H2, 48px);
      color: #FFF;
      margin: 0 0 16px;

      @media(max-width: 768px) {
        font-size: 32px;
        line-height: 40px;
      }

      @media(max-width: 600px) {
        font-size: 28px;
        line-height: 36px;
      }
    }

    .description__ {
      font-family: var(--font-body-family, "Cabinet Grotesk");
      font-size: var(--Font-Size-Paragraph-Large, 16px);
      font-style: normal;
      font-weight: 500;
      line-height: var(--Line-Height-Paragraph-Large, 24px);
      color: rgba(255, 255, 255, 0.9);
      margin: 0 0 32px;

      @media(max-width: 600px) {
        font-size: 14px;
        line-height: 20px;
        margin: 0 0 24px;
      }
    }

    .cta_button {
        width: max-content;
        margin: auto;
    }
  }

  @media(max-width: 600px) {
    #shopify-section-{{id}}  {
      margin-top: {{section.settings.margin_top_m | append: 'px'}};
      margin-bottom: {{section.settings.margin_bottom_m | append: 'px'}};
      padding-top: {{section.settings.padding_top_m | append: 'px'}};
      padding-bottom: {{section.settings.padding_bottom_m | append: 'px'}};
    }
  }
</style>

<div class="sec-{{ id }} {% unless section.settings.full_width %}page-width{% endunless %}" id="{{ section.settings.sec_id }} ">
  <div class="cta-container__ ">
    <div class="content__wrapper__">
      {% unless section.settings.heading == blank %}
        <h2 class="heading__">{{ section.settings.heading }}</h2>
      {% endunless %}

      {% unless section.settings.description == blank %}
        <p class="description__">{{ section.settings.description }}</p>
      {% endunless %}

      {% unless section.settings.button_text == blank %}
        <a href="{{ section.settings.button_url }}" class="cta_button">
          {{ section.settings.button_text }}
        </a>
      {% endunless %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CTA Banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Section",
      "default": false
    },
    {
      "type": "text",
      "id": "sec_id",
      "label": "Section Id"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFF5FF"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Container Background Image",
      "info": "If image is selected, it will override the gradient background"
    },
    {
      "type": "color_background",
      "id": "card_background",
      "label": "Container Background Gradient",
      "default": "linear-gradient(135deg, #8B4C6B 0%, #B8739B 100%)",
      "info": "Used only if no background image is selected"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the Loop with Glam Gel Nail's Latest News and Events"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Be the first to know about new drops, sales, and tips you'll love."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Section Spacing Desktop"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Section Spacing Mobile"
    },
    {
      "type": "range",
      "id": "margin_top_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_m",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "CTA Banner"
    }
  ]
}
{% endschema %}
